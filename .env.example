# Server
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://mongodb:27017/sid-software-solutions
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=12
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MS=900000

# Client (Vite — prefix VITE_)
VITE_API_URL=http://localhost:4000

# Docker Compose (optional overrides)
COMPOSE_PROJECT_NAME=sid-software-solutions
